import Cordis.Effects

/-!
The effect-function specialization of Cordis Definitions 40–42, read up to an
explicit observation relation. Independence is checked on generators, including
*every* execution-specific inverse. The closure theorems derive the corresponding
laws for the generated transformation monoids; forward commutation alone is not
an independence certificate. Outcome-dependent iterators are outside this module.
-/

namespace Cordis.Independence

open Effects
universe u
variable {S : Type u} [Setoid S]

def forward (e : Effect S) : S → S := fun s => (e.run s).1

def inverse (e : Effect S) (s : S) : S → S := (e.run s).2

inductive Generator (e : Effect S) : (S → S) → Prop
  | forward : Generator e (forward e)
  | inverse (s : S) : Generator e (inverse e s)

/-- The transformation monoid of finite compositions generated by an effect
(Definition 40); the monoid itself need not be finite. -/
inductive Generated (e : Effect S) : (S → S) → Prop
  | generator {f} : Generator e f → Generated e f
  | identity : Generated e id
  | compose {f g} : Generated e f → Generated e g → Generated e (f ∘ g)

def Commutes (f g : S → S) : Prop := ∀ s, f (g s) ≈ g (f s)

/-- Local proof obligations. Yield stability is separate from commutation. -/
structure Independent (a b : Effect S) : Prop where
  commute : ∀ f, Generator a f → ∀ g, Generator b g → Commutes f g
  left_yield : ∀ g, Generator b g → ∀ s, Related (inverse a (g s)) (inverse a s)
  right_yield : ∀ f, Generator a f → ∀ s, Related (inverse b (f s)) (inverse b s)

theorem related_trans {f g h : S → S} (hfg : Related f g) (hgh : Related g h) :
    Related f h := fun _ t hst => Setoid.trans (hfg hst) (hgh (Setoid.refl t))

theorem related_symm {f g : S → S} (hfg : Related f g) : Related g f :=
  fun _ _ hst => Setoid.symm (hfg (Setoid.symm hst))

/-- Operations additionally publish outcomes (Definition 44). -/
structure Operation (S : Type u) (Outcome : Type u) where
  effect : Effect S
  outcome : S → Outcome

/-- Outcomes are literal observations and must survive foreign transformations. -/
structure IndependentOperations {A B : Type u} (a : Operation S A) (b : Operation S B)
    : Prop extends Independent a.effect b.effect where
  left_outcome : ∀ g, Generator b.effect g → ∀ s, a.outcome (g s) = a.outcome s
  right_outcome : ∀ f, Generator a.effect f → ∀ s, b.outcome (f s) = b.outcome s

/-! Executable witnesses and a regression against confusing forward commutation
with selective rollback. These effects deliberately capture state-dependent undo. -/

end Cordis.Independence
